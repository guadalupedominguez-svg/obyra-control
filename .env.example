# Texto aleatorio de 32+ caracteres para cifrar la sesión (ej. salida de: openssl rand -hex 32)
SESSION_SECRET=
# Base de datos Upstash Redis (puede ser la misma de OBYRA; las llaves de esta app empiezan con "ctrl:")
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Primer administrador: se crea solo si todavía no hay ningún usuario
ADMIN_EMAIL=
ADMIN_PASSWORD=
# App de Autodesk Platform Services (para leer el IFC de Forma)
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Opcional: si no se define, se usa https://<tu-dominio>/api/forma/callback
APS_CALLBACK_URL=
